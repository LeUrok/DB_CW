<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:AnimalShelter.AnimalShelterUI.ViewModels"
        x:DataType="vm:AuthorizationWindowViewModel"
        x:CompileBindings="True"
        Width="400" Height="200"
        x:Class="AnimalShelterUI.AuthorizationWindow"
        Title="PetCareHub">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
          RowDefinitions="auto, auto, auto, auto">

         <TextBox Grid.Row="0" 
             Width="300" 
             Margin="0,0,0,10" 
             Watermark="Логин"
             Text="{Binding Login}"/>
    
         <TextBox Grid.Row="1" 
             Width="300" 
             Margin="0,0,0,10" 
             Watermark="Пароль" 
             PasswordChar="*"
             Text="{Binding Password}"/>
    
         <Button Content="Войти"
            Name="authorizationButton"
            HorizontalContentAlignment="Center"
            Grid.Row="2" 
            Click="AuthorizationButton"
            Margin="5"
            Width="300"/>

         <TextBlock Grid.Row="3"
                HorizontalAlignment="Center"
                Text="PetCareHub — система контроля животных внутри приюта"
                Foreground="#C0C0C0"
                Margin="0,10,0,0"
                Width="300"
                TextWrapping="Wrap"
                TextAlignment="Center"/>
    </Grid>
</Window>