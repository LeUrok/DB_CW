<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:AnimalShelter.AnimalShelterUI.ViewModels"
        x:DataType="vm:BreedTypeWindowViewModel"
        x:CompileBindings="True"
        Width="450" Height="700"
        x:Class="AnimalShelterUI.BreedTypeWindow"
        Title="Редактирование видов и пород">
    <Grid HorizontalAlignment="Center" 
        
        RowDefinitions="auto, *, auto, auto, *, auto"
        ColumnDefinitions="auto, auto, auto">
            <Label Grid.Row="0" 
                Grid.Column="0" 
                FontWeight="Bold"
                FontSize="18" 
                Content="Виды:" 
                HorizontalAlignment="Left"
                Width="100"/>
            <ListBox Name="typesList" 
                    Grid.Row="1" 
                    Grid.Column="0" 
                    Grid.ColumnSpan="3"
                    ItemsSource="{Binding TypesList}"/>
            
            <TextBox Name="typeTextBox" 
                    Grid.Row="2"
                    Grid.Column="0"   
                    Width="200"
                    Text="{Binding Type}"
                    Margin="0,10,0,20"/>
            
            <Button Grid.Row="2"
                    Grid.Column="1"  
                    Content="Добавить" 
                    Margin="10,10,0,20"
                    Click="AddTypeButton"/>
            <Button Grid.Row="2"
                    Grid.Column="2"  
                    Content="Удалить" 
                    Margin="10,10,0,20"
                    Click="RemoveTypeButton"/>
            

            <Label  Grid.Row="3"
                    Grid.Column="0"
                    Content="Породы:"
                    FontWeight="Bold"
                    FontSize="18"
                    HorizontalAlignment="Left"
                    Width="100"/>
            <ListBox Name="breedsList" 
                    Grid.Row="4" 
                    Grid.Column="0" 
                    Grid.ColumnSpan="3"
                    ItemsSource="{Binding BreedsList}"/>
            
            <TextBox Name="breedTextBox" 
                    Grid.Row="5"
                    Grid.Column="0"
                    Width="200"
                    Text="{Binding Breed}"
                    Margin="0,10,0,10"/>
            
            <Button Grid.Row="5"
                    Grid.Column="1"
                    Content="Добавить" 
                    Margin="10,10,0,10"
                    Click="AddBreedButton"/>
            <Button Grid.Row="5"
                    Grid.Column="2"  
                    Content="Удалить" 
                    Margin="10,10,0,10"
                    Click="RemoveBreedButton"/>
    </Grid>
</Window>

